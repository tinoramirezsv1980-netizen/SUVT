# Copiar como .env en la raíz (no commitear valores reales)

HTTP_PORT=8080

# Opción A — MySQL de XAMPP (host Windows). Usuario root sin clave por defecto.
DATABASE_URL=mysql://root:@host.docker.internal:3306/rnpn_vehiculos_nueva

# Opción B — MySQL en Docker (docker-compose.mysql.yml)
DB_ROOT_PASSWORD=cambiar_root
DB_PASSWORD=cambiar_db
MYSQL_PORT=3307

JWT_SECRET=cambiar_por_cadena_aleatoria_larga_minimo_64_caracteres
CORS_ORIGIN=http://localhost:8080

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RNPN Vehiculos <notificaciones@rnpn.gob.sv>
EMAIL_SUPERVISORES=supervisor@rnpn.gob.sv
EMAIL_ADMINS=admin@rnpn.gob.sv

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
