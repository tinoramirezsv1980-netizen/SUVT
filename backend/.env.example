# ============================================================
#  RNPN — Variables de entorno (MySQL / XAMPP)
#  Copiar como .env y completar los valores
# ============================================================

# Servidor
NODE_ENV=development
PORT=4000

# MySQL (XAMPP — usuario root sin contraseña por defecto)
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://root:@localhost:3306/rnpn_vehiculos"

# JWT
JWT_SECRET=cambiar_por_cadena_aleatoria_larga
JWT_EXPIRES_IN=8h

# Correo (notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@rnpn.gob.sv
SMTP_PASS=app_password_aqui
SMTP_FROM="RNPN Vehículos <notificaciones@rnpn.gob.sv>"

# Destinatarios de alertas
EMAIL_SUPERVISORES=supervisor@rnpn.gob.sv
EMAIL_ADMINS=admin@rnpn.gob.sv

# CORS — origen permitido del frontend
CORS_ORIGIN=http://localhost:5173

# Alertas mantenimiento (km)
UMBRAL_KM_MANTENIMIENTO=50000

# Logs
LOG_LEVEL=info
