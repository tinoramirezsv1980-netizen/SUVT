# Variables para compilar el APK Android (Fase 3 — Capacitor)
# Copiar como .env.apk y usar:  npm run build:apk  (o setear VITE_API_URL manualmente)

# --- PRODUCCION (nube) ---
# VITE_API_URL=https://trazabilidad.rnpn.gob.sv/api
#   ó si aun no hay dominio, apuntar a Render:
# VITE_API_URL=https://<tu-backend>.onrender.com/api

# --- PRUEBAS EN LA MISMA RED LOCAL (APK) ---
# Apuntar al backend de la PC. NO usar localhost (el celular no lo resuelve).
# VITE_API_URL=http://192.168.x.x:8080/api
#   (si es HTTP en Android, el AndroidManifest ya trae usesCleartextTraffic=true)